<Window x:Class="Tonghopbansung.Views.ImportSessionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nhập đợt bắn"
        Width="520"
        MinWidth="480"
        MinHeight="300"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBg}"
        Loaded="Window_Loaded">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Hủy" IsCancel="True" Padding="14,8" MinWidth="90" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Nhập" IsDefault="True" Style="{StaticResource BtnPrimary}"
                    Padding="14,8" MinWidth="100" Click="Ok_Click"/>
        </StackPanel>

        <StackPanel>
            <TextBlock Text="Nhập đợt bắn từ file .thbss" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12"/>

            <TextBlock x:Name="SummaryText" Margin="0,0,0,14" TextWrapping="Wrap"/>

            <TextBlock Text="Cách nhập" Style="{StaticResource FieldLabel}"/>
            <RadioButton x:Name="CreateRadio" Content="Tạo đợt mới"
                         GroupName="ImportMode"
                         Margin="0,0,0,6"
                         Checked="CreateMode_Checked"/>
            <RadioButton x:Name="AppendRadio"
                         GroupName="ImportMode"
                         Margin="0,0,0,14"
                         Checked="AppendMode_Checked">
                <TextBlock x:Name="AppendLabel" TextWrapping="Wrap"/>
            </RadioButton>

            <TextBlock Text="Nhóm đích (preset cùng cấu hình)" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="GroupCombo"
                      ItemsSource="{Binding MatchingGroups}"
                      SelectedItem="{Binding SelectedGroup}"
                      DisplayMemberPath="Name"
                      MinHeight="32"/>
        </StackPanel>
    </DockPanel>
</Window>
