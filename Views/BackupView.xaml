<UserControl x:Class="Tonghopbansung.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="700">
    <Grid Margin="24" MaxWidth="720" HorizontalAlignment="Left">
        <StackPanel>
            <TextBlock Text="SAO LƯU &amp; PHỤC HỒI" Style="{StaticResource SectionTitle}"/>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <TextBlock Text="{Binding InfoText}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13"/>
            </Border>

            <WrapPanel>
                <Button Content="Sao lưu..." Command="{Binding BackupCommand}" Style="{StaticResource BtnPrimary}" Margin="0,0,10,10" Padding="16,10" MinWidth="140"/>
                <Button Content="Phục hồi..." Command="{Binding RestoreCommand}" Style="{StaticResource BtnDanger}" Margin="0,0,10,10" Padding="16,10" MinWidth="140"/>
                <Button Content="Xóa dữ liệu..." Command="{Binding DeleteDataCommand}" Style="{StaticResource BtnDanger}" Margin="0,0,10,10" Padding="16,10" MinWidth="140"/>
                <Button Content="Mở thư mục dữ liệu" Command="{Binding OpenDataFolderCommand}" Style="{StaticResource BtnSecondary}" Margin="0,0,10,10" Padding="16,10"/>
                <Button Content="Lưu ngay" Command="{Binding SaveNowCommand}" Style="{StaticResource BtnPrimary}" Margin="0,0,10,10" Padding="16,10"/>
            </WrapPanel>
        </StackPanel>
    </Grid>
</UserControl>
