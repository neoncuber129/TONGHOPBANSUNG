<Window x:Class="Tonghopbansung.Views.CreateSessionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tạo đợt bắn"
        Width="520"
        MinWidth="480"
        MinHeight="320"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBg}">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Hủy" IsCancel="True" Padding="14,8" MinWidth="90" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Tạo đợt" IsDefault="True" Style="{StaticResource BtnPrimary}"
                    Padding="14,8" MinWidth="100" Click="Ok_Click"/>
        </StackPanel>

        <StackPanel>
            <TextBlock Text="Tạo đợt bắn mới" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}" Margin="0,0,0,16"/>

            <TextBlock Text="Tên đợt" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding SessionName, UpdateSourceTrigger=PropertyChanged}"
                     MinHeight="32" Margin="0,0,0,14"/>

            <TextBlock Text="Nhóm (cấu hình bia)" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{Binding Groups}"
                      SelectedItem="{Binding SelectedGroup}"
                      DisplayMemberPath="Name"
                      MinHeight="32" Margin="0,0,0,14"/>

            <TextBlock Text="Số người" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding PersonCount, UpdateSourceTrigger=PropertyChanged}"
                     Width="120" HorizontalAlignment="Left" MinHeight="32"/>
        </StackPanel>
    </DockPanel>
</Window>
