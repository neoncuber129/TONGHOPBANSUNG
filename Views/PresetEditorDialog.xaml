<Window x:Class="Tonghopbansung.Views.PresetEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DialogTitle}"
        Height="640" Width="900"
        MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBg}"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="WizardCard" TargetType="Border" BasedOn="{StaticResource CardBorder}">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" Text="{Binding StepHint}" Margin="0,0,0,10" Opacity="0.8" TextWrapping="Wrap"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Đóng" Click="Close_Click" Padding="16,8" MinWidth="90"/>
        </StackPanel>

        <!-- Bước 1: Nhóm -->
        <Border DockPanel.Dock="Top" Style="{StaticResource WizardCard}"
                Visibility="{Binding PresetStep, Converter={StaticResource EnumToVis}, ConverterParameter=GroupName}">
            <StackPanel>
                <TextBlock Text="1. NHÓM" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Tên nhóm" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding Preset.Name, UpdateSourceTrigger=PropertyChanged}" Width="320" MinHeight="28" Margin="0,0,12,0"/>
                    <Button Content="Tiếp →" Command="{Binding ApplyGroupNameCommand}" Style="{StaticResource BtnPrimary}" Padding="14,6"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Bước 2: Số phần -->
        <Border DockPanel.Dock="Top" Style="{StaticResource WizardCard}"
                Visibility="{Binding PresetStep, Converter={StaticResource EnumToVis}, ConverterParameter=ClusterCount}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="2. PHẦN" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                    <Button Content="← Quay lại" Command="{Binding BackStepCommand}" Margin="16,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Có bao nhiêu phần?" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Text="{Binding DesiredClusterCount, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,12,0"/>
                    <Button Content="Tiếp →" Command="{Binding ApplyClusterCountCommand}" Style="{StaticResource BtnPrimary}" Padding="14,6"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Bước 3: Số bia từng phần -->
        <Border DockPanel.Dock="Top" Style="{StaticResource WizardCard}"
                Visibility="{Binding PresetStep, Converter={StaticResource EnumToVis}, ConverterParameter=TargetsPerCluster}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="3. SỐ BIA TỪNG PHẦN" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                    <Button Content="← Quay lại" Command="{Binding BackStepCommand}" Margin="16,0,8,0"/>
                    <Button Content="Tạo bảng →" Command="{Binding BuildPresetFromSetupCommand}" Style="{StaticResource BtnPrimary}" Padding="14,6"/>
                </StackPanel>
                <DataGrid ItemsSource="{Binding ClusterSetupRows}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="All"
                          MinHeight="180">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="STT" Binding="{Binding Index}" Width="50" IsReadOnly="True"
                                            ElementStyle="{StaticResource DataGridTextCenter}"
                                            EditingElementStyle="{StaticResource DataGridEditCenter}"/>
                        <DataGridTextColumn Header="Tên phần"
                                            Binding="{Binding ClusterName, UpdateSourceTrigger=PropertyChanged}" Width="*"
                                            ElementStyle="{StaticResource DataGridTextCenter}"
                                            EditingElementStyle="{StaticResource DataGridEditCenter}"/>
                        <DataGridTextColumn Header="Số bia trong phần"
                                            Binding="{Binding TargetCount, UpdateSourceTrigger=PropertyChanged}" Width="150"
                                            ElementStyle="{StaticResource DataGridTextCenter}"
                                            EditingElementStyle="{StaticResource DataGridEditCenter}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- Bước 4: chi tiết -->
        <DockPanel Visibility="{Binding PresetStep, Converter={StaticResource EnumToVis}, ConverterParameter=DetailEdit}">
            <Border DockPanel.Dock="Top" Style="{StaticResource WizardCard}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="Tên nhóm" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                    <TextBox Text="{Binding Preset.Name, UpdateSourceTrigger=PropertyChanged}" MinHeight="28"/>
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Style="{StaticResource CardBorder}" Margin="0,10,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="PHÂN LOẠI" Style="{StaticResource SectionTitle}"/>
                    <TextBlock DockPanel.Dock="Top" Opacity="0.75" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap"
                               Text="Điều kiện theo tổng điểm và/hoặc từng bia. Thêm / Sửa mở popup (nút + để thêm điều kiện bia)."/>
                    <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0">
                        <Button Content="Thêm" Command="{Binding AddRuleCommand}" Style="{StaticResource BtnSecondary}" Margin="0,0,0,6"/>
                        <Button Content="Sửa" Command="{Binding EditRuleCommand}" Style="{StaticResource BtnSecondary}" Margin="0,0,0,6"/>
                        <Button Content="Xóa" Command="{Binding RemoveRuleCommand}" Style="{StaticResource BtnDanger}"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Preset.ClassificationRules}"
                              SelectedItem="{Binding SelectedRule}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              MinHeight="90" MaxHeight="140"
                              MouseDoubleClick="RulesGrid_OnMouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Hạng" Binding="{Binding Label}" Width="100"
                                                ElementStyle="{StaticResource DataGridTextCenter}"/>
                            <DataGridTextColumn Header="Ưu tiên" Binding="{Binding EffectivePriority}" Width="70"
                                                ElementStyle="{StaticResource DataGridTextCenter}"/>
                            <DataGridTextColumn Header="Điều kiện" Binding="{Binding ConditionSummary}" Width="*"
                                                ElementStyle="{StaticResource DataGridTextCenter}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="4. SỬA TÊN PHẦN &amp; BIA" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                <Button Content="← Thiết lập lại" Command="{Binding RestartSetupCommand}" Style="{StaticResource BtnDanger}" Margin="16,0,8,0"/>
                <Button Content="Lưu" Command="{Binding SavePresetDetailCommand}" Style="{StaticResource BtnPrimary}" Padding="14,6"/>
            </StackPanel>

            <TreeView ItemsSource="{Binding Preset.Clusters}"
                      SelectedItemChanged="Tree_OnSelectedItemChanged"
                      BorderBrush="{StaticResource BorderBrushSoft}"
                      BorderThickness="1"
                      Background="White">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Targets}">
                        <Border Background="#E8F0E7" Padding="8,6" Margin="0,2" CornerRadius="3" MinWidth="620">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="PHẦN" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                        </Border>
                        <HierarchicalDataTemplate.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                                        Background="#FAFCFA" Padding="8,5" Margin="28,2,0,2" MinWidth="720">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="280"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Bia" VerticalAlignment="Center" Foreground="#5A6B5E"/>
                                        <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                    Visibility="{Binding ShowRoundCount, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Số đạn" VerticalAlignment="Center" Margin="0,0,6,0"
                                                       FontSize="12" Foreground="#3A4A3E"/>
                                            <TextBox Text="{Binding RoundCount, UpdateSourceTrigger=PropertyChanged}" Width="48"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="5" Orientation="Horizontal"
                                                    Visibility="{Binding ShowKnockDownScores, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Đổ +" VerticalAlignment="Center" Margin="0,0,4,0"
                                                       FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                                            <TextBox Text="{Binding HitBonus, UpdateSourceTrigger=PropertyChanged}" Width="44"
                                                     ToolTip="Số điểm cộng khi kết quả là «Đổ»"/>
                                            <TextBlock Text="đ" VerticalAlignment="Center" Margin="4,0,12,0"
                                                       FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                                            <TextBlock Text="Không đổ −" VerticalAlignment="Center" Margin="0,0,4,0"
                                                       FontSize="12" Foreground="#8B3A34"/>
                                            <TextBox Text="{Binding MissPenalty, UpdateSourceTrigger=PropertyChanged}" Width="44"
                                                     ToolTip="Số điểm trừ khi kết quả là «Không»"/>
                                            <TextBlock Text="đ" VerticalAlignment="Center" Margin="4,0,0,0"
                                                       FontSize="12" Foreground="#8B3A34"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="7" Text="{Binding KindLabel}" VerticalAlignment="Center"
                                                   FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                        <Button Grid.Column="9"
                                                Content="{Binding KindToggleLabel}"
                                                Padding="10,4"
                                                Command="{Binding DataContext.ToggleTargetKindCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </HierarchicalDataTemplate.ItemTemplate>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </DockPanel>
    </DockPanel>
</Window>
