<Window x:Class="Tonghopbansung.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Tonghopbansung.Views"
        xmlns:vm="clr-namespace:Tonghopbansung.ViewModels"
        mc:Ignorable="d"
        Title="Tổng hợp điểm bắn súng"
        Icon="pack://application:,,,/app.ico"
        Height="720" Width="1180"
        MinHeight="560" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBg}" Padding="16,14">
                <TextBlock Text="TỔNG HỢP ĐIỂM BẮN SÚNG" FontSize="20" FontWeight="Bold"
                           Foreground="White" FontFamily="Segoe UI Semibold"
                           VerticalAlignment="Center"/>
            </Border>

            <StatusBar DockPanel.Dock="Bottom" Background="#E8EEE6">
                <StatusBarItem>
                    <TextBlock Text="{Binding Session.StatusMessage}"/>
                </StatusBarItem>
                <StatusBarItem Visibility="{Binding Session.IsBusy, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                        <ProgressBar Width="140" Height="10" IsIndeterminate="True" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Session.BusyMessage}" VerticalAlignment="Center" Opacity="0.85"/>
                    </StackPanel>
                </StatusBarItem>
            </StatusBar>

            <TabControl Margin="8" Padding="0">
                <TabItem Header="1. Nhóm">
                    <views:GroupsPresetsView DataContext="{Binding GroupsPresets}"/>
                </TabItem>
                <TabItem Header="2. Danh sách &amp; nhập liệu">
                    <views:ScoreEntryView DataContext="{Binding ScoreEntry}"/>
                </TabItem>
                <TabItem Header="3. Sao lưu">
                    <views:BackupView DataContext="{Binding Backup}"/>
                </TabItem>
                <TabItem Header="4. About">
                    <views:AboutView/>
                </TabItem>
            </TabControl>
        </DockPanel>

        <!-- Overlay khi thao tác nặng -->
        <Border Background="#66000000"
                Visibility="{Binding Session.IsBusy, Converter={StaticResource BoolToVis}}"
                IsHitTestVisible="True"
                Panel.ZIndex="100">
            <Border Background="White" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                    CornerRadius="6" Padding="28,24" MinWidth="300" MaxWidth="420"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding Session.BusyMessage}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"
                               HorizontalAlignment="Center" Margin="0,0,0,14"/>
                    <ProgressBar Height="12" IsIndeterminate="True"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
